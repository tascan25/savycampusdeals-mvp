# Copy to .env.development / .env.staging / .env.production (see docs/environment.md).
# Every value here is bundled into the app and extractable by anyone with the
# built binary — never put a secret in this file. Server-side secrets
# (JWT_SECRET, Cloudinary, Resend, FCM service account, APNs key, etc.) live
# only in backend/.env and are never referenced from mobile/.

# Which environment this build targets: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Base URL of the FastAPI backend, WITHOUT the /api suffix (the API client
# appends it, same convention as frontend/src/lib/api.js).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Base URL of the marketing/web frontend. Some offer/outlet media fields
# (image_url, brand_logo, logo_url, cover_url) come back as paths relative to
# the WEBSITE's own static hosting (frontend/public/images/...), not the API
# — a browser resolves those against its current origin, but the app has no
# such origin, so this is required to turn them into loadable absolute URLs.
# See src/utils/media.ts.
EXPO_PUBLIC_WEB_URL=http://127.0.0.1:3000

# Build-time path to this environment's Firebase Android configuration.
# This is intentionally not EXPO_PUBLIC_*: app.config.ts consumes the path
# while generating the native project. Use a different file for development
# and production, for example ./firebase/google-services.development.json.
# GOOGLE_SERVICES_FILE=./firebase/google-services.development.json

# Product identity overrides — leave unset to use the recommended defaults
# (Savvy Campus / in.savvycampus.app) baked into app.config.ts. Only change
# these with explicit owner approval; see docs/store-release.md.
# EXPO_PUBLIC_APP_NAME=Savvy Campus
# EXPO_PUBLIC_APP_SLUG=savvy-campus
# EXPO_PUBLIC_URL_SCHEME=savvycampus
# EXPO_PUBLIC_ANDROID_PACKAGE=in.savvycampus.app
# EXPO_PUBLIC_IOS_BUNDLE_ID=in.savvycampus.app
# EXPO_PUBLIC_PRODUCTION_DOMAIN=savvycampus.app
